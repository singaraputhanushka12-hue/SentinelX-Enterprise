# Copy to .env for Docker Compose. Replace the database password before use.
POSTGRES_PASSWORD=sentinelx-local-development

# Optional provider configuration. The two URL fields for intelligence must use HTTPS.
SENTINELX_MISP_URL=
SENTINELX_MISP_API_KEY=
SENTINELX_TAXII_OBJECTS_URL=
SENTINELX_TAXII_TOKEN=
SENTINELX_VT_API_KEY=
SENTINELX_LLM_GATEWAY_URL=
SENTINELX_LLM_GATEWAY_TOKEN=

# External AI requires explicit authorization for each organization ID.
OPENAI_API_KEY=
SENTINELX_OPENAI_MODEL=gpt-5-mini
SENTINELX_AI_ALLOWED_ORGS=78cf6c498fcb5b025cf925ddc136e745

